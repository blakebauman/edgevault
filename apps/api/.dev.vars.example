# apps/api local dev secrets — copy to `.dev.vars` and fill in.
# `.dev.vars` is gitignored; this example is committed. Generate real values
# with `node scripts/gen-secrets.mjs` from the repo root.
#
# For `wrangler dev` / tests, the Hyperdrive localConnectionString points at the
# Neon Local container (`pnpm db:up`), so no DATABASE_URL is needed here.

# Envelope-encryption master key (base64, 32 bytes). Must be the SAME value as
# apps/auth's MASTER_KEK or secrets written by one worker won't decrypt in the
# other.
MASTER_KEK='base64-32-bytes-here'

# Internal mesh shared secret (shared with auth + console). Guards internal
# service-to-service routes.
INTERNAL_TOKEN='hex-or-base64url-here'

# Console origin used when building user-facing links.
CONSOLE_URL='https://console.edgevault.io'

# Set to 1 to enable the local-dev seed endpoint (/internal/seed) used by
# `pnpm seed:dev`. Leave UNSET in any deployed environment — its absence is what
# keeps the seed endpoint inert in staging/prod.
ALLOW_DEV_SEED='1'

# --- Optional: assistant model provider -------------------------------------
# Unset by default, and that is the supported configuration: the assistant runs
# on Workers AI (TEXT_MODEL in wrangler.jsonc) with no third-party account.
# Setting a key here switches chat — and only chat — to Anthropic. Embeddings
# and risk scoring stay on Workers AI regardless. See src/agent/providers.ts.
# ANTHROPIC_API_KEY='sk-ant-...'
# ANTHROPIC_MODEL='claude-sonnet-4-6'

# Cloudflare account id, needed ONLY to proxy the above through AI Gateway
# (pair it with AI_GATEWAY_ID in wrangler.jsonc). The Workers AI path reaches
# the gateway through its binding and does not need this.
# AI_GATEWAY_ACCOUNT_ID='...'
