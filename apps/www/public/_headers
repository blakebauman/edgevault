# Security headers for the static marketing site (Workers Assets honors this
# file like Pages). The site ships 0 KB of client JS; styles are Astro-inlined
# plus hashed /_astro/*.css, with webfonts from Google Fonts.

# Astro content-hashes everything under /_astro/, so a URL only changes when its
# bytes do. Without a rule here these inherited the Workers Assets default of
# `public, max-age=0, must-revalidate` — the edge cached them, but every browser
# still paid a revalidation round-trip for each one on every page load.
#
# Cache-Control belongs ONLY in this block. Every matching rule is applied and
# the values are concatenated, so putting one on `/*` too would reach these
# files as `max-age=0, must-revalidate, public, max-age=31536000, immutable`,
# where the stricter directive wins and the immutable one does nothing.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/*
  Content-Security-Policy: default-src 'none'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; frame-ancestors 'none'; base-uri 'none'; form-action 'none'
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
